# Karoli Interior Hub - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Backend Port & MongoDB URI
PORT=5000
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxx.mongodb.net/<DATABASE>?appName=Cluster0

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Admin Credentials (first-run seeding)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongPassword123

# Client Business Information
COMPANY_NAME=Your Company Name
PHONE_PRIMARY=0000000000
PHONE_SECONDARY=0000000000
EMAIL_CONTACT=contact@yourdomain.com
WHATSAPP_NUMBER=910000000000

# Email SMTP Settings (For Real OTP Delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
